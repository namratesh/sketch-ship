GOOGLE_API_KEY=your-google-ai-studio-key-here

# SerpApi key (https://serpapi.com, free-trial credit works) -- used for real
# reverse-image "web-scan" leak detection via the Google Lens engine.
# Leave unset to skip real web scanning (falls back to no-op).
SERPAPI_KEY=your-serpapi-key-here

# --- Local disk mode (docker-compose / `uvicorn app.main:app` locally) ---
# Only used when the S3_* vars below are NOT set. Public URL this backend is
# reachable at, so SerpApi's servers can fetch uploaded asset images (it
# needs a URL, not raw bytes). Point this at an ngrok tunnel
# (`ngrok http 8000`) or your real public deployment URL.
PUBLIC_BASE_URL=http://localhost:8000

# --- Object storage mode (required on Vercel -- no persistent/shared disk) ---
# Set all four to switch db.json + uploaded images from local disk to an
# S3-compatible bucket (Cloudflare R2 recommended: S3-compatible, free tier,
# zero egress). When set, PUBLIC_BASE_URL above is ignored -- image URLs are
# already public bucket URLs.
# S3_BUCKET=ghosttrace
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your-r2-access-key-id
# S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Public base URL for reading back what you upload (R2's public bucket
# domain, or a custom domain in front of it). Falls back to
# S3_ENDPOINT_URL/S3_BUCKET if unset, which usually is NOT publicly
# readable for R2 -- set this explicitly.
# S3_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Comma-separated extra CORS origins (the deployed frontend's URL).
# http://localhost:5173 is always allowed in addition to these.
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
